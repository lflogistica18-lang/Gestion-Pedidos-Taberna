# Supabase (usar la clave ANON, NUNCA la service key)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Usuario de la app con rol "taberna" (creado solo para imprimir)
PRINT_EMAIL=impresion@taberna.local
PRINT_PASSWORD=

# Tipo de impresora: "red" (comandera con IP) o "windows" (impresora USB instalada en Windows, por nombre)
TIPO_IMPRESORA=red

# Solo si TIPO_IMPRESORA=windows: nombre exacto de la impresora en Windows
# (Configuración > Impresoras y escáneres). En Windows lo normal es usar ImpresoraTaberna.exe.
IMPRESORA_WINDOWS=

# Solo si TIPO_IMPRESORA=red: impresora térmica (IP fija o reservada en el router)
IMPRESORA_IP=192.168.1.50
IMPRESORA_PUERTO=9100

# Respaldo si no se puede leer Configuración en la app (ancho de papel y nombre salen de ahí)
# Columnas: 48 para 80mm (Font A), 32 para 58mm
COLUMNAS=48
NOMBRE_LOCAL=La Taberna

# Número para ESC t n (2 = PC850 en red; 16 = WPC1252 en la impresora USB del local)
CODEPAGE=2

# true = no imprime: muestra el ticket en consola y guarda el binario en ./simulados
SIMULAR=false

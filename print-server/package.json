{
  "name": "sgp-print-server",
  "version": "1.0.0",
  "description": "Servidor de impresión para SGP: escucha la cola print_jobs en Supabase y manda tickets a una comandera ESC/POS por TCP",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "prueba": "tsx src/prueba.ts",
    "prueba:prod": "node dist/prueba.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2",
    "dotenv": "^16"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  }
}
